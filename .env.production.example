# Environment Configuration Example for NusantaraOrigin Production
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public Canonical URL of the platform
NEXT_PUBLIC_SITE_URL=https://nusantaraorigin.com

# WhatsApp Export Director Hotline (International format without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Supabase Managed Cloud Database & Storage (100% Free Tier - Optional)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Optional: Next.js Telemetry Opt-out
NEXT_TELEMETRY_DISABLED=1
