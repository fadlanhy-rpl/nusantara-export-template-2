# Environment Configuration Example for NusantaraOrigin Production
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public Canonical URL of the platform
NEXT_PUBLIC_SITE_URL=https://nusantaraorigin.com

# WhatsApp Export Director Hotline (International format without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Optional: Next.js Telemetry Opt-out
NEXT_TELEMETRY_DISABLED=1
